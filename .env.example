DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local development can use SQLite. Set DB_ENGINE=mysql to use MySQL.
DB_ENGINE=sqlite
DB_NAME=containerpro
DB_USER=containerpro_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Set these in the environment before deploying; never commit real credentials.
DJANGO_SECURE_SSL_REDIRECT=False

# Local development prints email messages in the runserver console.
# For production, configure a real SMTP provider.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=
CONTACT_RECIPIENT_EMAIL=

# Mercado Pago Checkout Pro; use test credentials and a public HTTPS tunnel while developing.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_PUBLIC_BASE_URL=
MP_USE_SANDBOX=True

# Phone verification SMS via Twilio; configure either a sender number or a messaging service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
